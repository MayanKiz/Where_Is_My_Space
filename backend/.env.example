# Server-side Supabase credentials only. Never commit real values.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Private storage buckets created by the Supabase migrations.
SUPABASE_VIDEO_BUCKET=wims-temporary-videos
SUPABASE_PREVIEW_BUCKET=wims-job-previews

# Include localhost and the exact deployed frontend origin(s).
CORS_ORIGINS=http://localhost:3000

# Maximum video size (MiB) and time to keep an unprocessed source video.
MAX_UPLOAD_MIB=100
UPLOAD_TTL_MINUTES=30
TEMP_UPLOAD_DIR=/tmp/wims-upload-staging

# In-process sliding-window rate limits (requests per minute per client).
RATE_LIMIT_PER_MINUTE=120
UPLOAD_RATE_LIMIT_PER_MINUTE=10

# Shared beta pairing code entered in the Capture app. Generate a random value.
# Example command: python -c "import secrets; print(secrets.token_urlsafe(24))"
WIMS_CAPTURE_ACCESS_CODE=

# Encrypt RTSP/RTSPS connection URLs at rest. Generate once and persist the same key:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Do not rotate this key without re-encrypting registered source URLs.
WIMS_SOURCE_ENCRYPTION_KEY=

# --- AI inference worker (python -m app.worker) -----------------------------
# Shares SUPABASE_* and WIMS_SOURCE_ENCRYPTION_KEY with the API service.
# Model weights download once and are verified against a pinned SHA-256.
YOLO_MODEL_PATH=models/yolov5s.onnx
YOLO_MODEL_URL=https://github.com/ultralytics/yolov5/releases/download/v7.0/yolov5s.onnx
DETECTION_CONFIDENCE=0.35
DETECTION_IOU=0.45
FRAME_STRIDE=5
MAX_SAMPLED_FRAMES=60
POLL_SECONDS=5
STALE_CLAIM_MINUTES=30
# Set true only for debugging: keeps the raw clip after processing instead of deleting it.
KEEP_RAW_VIDEO=false
# Continuous RTSP analysis interval per camera, in seconds.
STREAM_INTERVAL_SECONDS=10