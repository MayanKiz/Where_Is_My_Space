# Supabase project URL and service-role key are server-only secrets.
# NEVER put SUPABASE_SERVICE_ROLE_KEY in the frontend or commit real credentials.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Keep this bucket private. The SQL migration creates it.
SUPABASE_VIDEO_BUCKET=wims-temporary-videos

# Comma-separated frontend origins, not full paths.
CORS_ORIGINS=http://localhost:3000

# Maximum video size (MiB) and temporary retention window.
MAX_UPLOAD_MIB=100
UPLOAD_TTL_MINUTES=30
TEMP_UPLOAD_DIR=/tmp/wims-upload-staging
