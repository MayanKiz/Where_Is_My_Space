# Public frontend URL for the separately deployed WIMS API.
NEXT_PUBLIC_WIMS_API_URL=http://localhost:8000

# Optional browser-readable Supabase values for later read-only dashboard features.
# NEVER put SUPABASE_SERVICE_ROLE_KEY or WIMS_CAPTURE_ACCESS_CODE in this file.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
